{
  "name": "@wppconnect/wa-proto",
  "version": "2.3000.1045067870",
  "description": "Protobuf files from WhatsApp WEB",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wppconnect-team/wa-proto.git"
  },
  "author": {
    "name": "Cleiton Costa",
    "url": "https://github.com/icleitoncosta"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "npm run fetch && npm run compile",
    "compile": "npm run compile:js && npm run compile:ts",
    "compile:js": "node scripts/patch-protobufjs-parser.js && pbjs -t static-module --sparse -w commonjs -o ./dist/index.js ./WAProto.proto",
    "compile:ts": "pbts -o ./dist/index.d.ts ./dist/index.js",
    "fetch": "node index.js"
  },
  "dependencies": {
    "long": "^5.3.2",
    "protobufjs": "^8.7.2"
  },
  "devDependencies": {
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "protobufjs-cli": "^2.6.2",
    "puppeteer-real-browser": "^1.4.4"
  }
}
